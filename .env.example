# ==============================================================================
# Baqaya Web Application - Environment Variables Template
# Copy this file to backend/.env (and frontend/.env if customizing API URL)
# NEVER commit real secrets or passwords to version control.
# ==============================================================================

# Server Configuration
APP_ENV=development
SERVER_PORT=8080
TZ=Asia/Baghdad

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=baqaya
DB_TLS=false

# JWT Authentication
# Generate a strong random secret (at least 32 characters) for production
JWT_SECRET=replace-with-a-strong-random-secret-key-at-least-32-chars
JWT_EXPIRY_HOURS=24

# Demo Data Seeding
# Set to true in development to seed fictional Sulaymaniyah demo data if tables are empty
SEED_DEMO_DATA=true

