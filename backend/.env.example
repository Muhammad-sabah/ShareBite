# ==============================================================================
# Baqaya Backend - Environment Variables Template
# Copy to .env and replace placeholders with your local values.
# ==============================================================================

APP_ENV=development
SERVER_PORT=8080
TZ=Asia/Baghdad

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=baqaya
DB_TLS=false

JWT_SECRET=replace-with-a-strong-random-secret-key-at-least-32-chars
JWT_EXPIRY_HOURS=24

SEED_DEMO_DATA=true

